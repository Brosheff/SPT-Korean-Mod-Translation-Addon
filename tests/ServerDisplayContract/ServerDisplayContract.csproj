    <Compile Include="../../server-src/SPT_Mod_Korean_Server/MessageTranslator.cs" Link="MessageTranslator.cs" />
    <Compile Include="../../server-src/SPT_Mod_Korean_Server/ServerTextRules.cs" Link="ServerTextRules.cs" />
    <Compile Include="../../server-src/SPT_Mod_Korean_Server/TranslationModels.cs" Link="TranslationModels.cs" />
    <Compile Include="../../server-src/SPT_Mod_Korean_Server/CultureRegistry.cs" Link="CultureRegistry.cs" />
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SPTPath)/SPT_Runtime/SPTarkov.Server.Core.dll</HintPath></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SPTPath)/SPT_Runtime/SPTarkov.Common.dll</HintPath></Reference>
  </ItemGroup>
</Project>
