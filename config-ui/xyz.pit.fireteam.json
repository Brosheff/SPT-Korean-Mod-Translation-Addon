    {
      "section": "",
      "key": "06 EnemyKilledDisplayTime",
      "source_display_name": "Kill Display Time",
      "source_description": "Time in seconds to display killed-enemy skull markers after Status Report or an automatic kill-marker trigger. The marker never displays longer than Kill Remember Time.",
      "translation_display_name": "처치 표식 표시 시간",
      "translation_description": "상태 보고 또는 자동 처치 표식이 발동한 뒤 처치한 적의 해골 표식을 표시할 시간(초)입니다. 표시는 \"처치 위치 기억 시간\"보다 오래 유지되지 않습니다.",
      "values": []
    },
    {
      "section": "",
      "key": "06 EnemyKilledRetainTime",
      "source_display_name": "Kill Remember Time",
      "source_description": "Time in seconds to remember the position of an enemy killed by the player or a follower. This is also the maximum time a kill marker can remain visible.\nSet to 0 to disable killed-enemy markers.",
      "translation_display_name": "처치 위치 기억 시간",
      "translation_description": "플레이어나 분대원이 처치한 적의 위치를 기억할 시간(초)입니다. 처치 표식이 유지될 수 있는 최대 시간이기도 합니다.\n0으로 설정하면 처치한 적의 표식을 비활성화합니다.",
      "values": []
    }
  ]
}
