<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SPT_Mod_Korean_Server</AssemblyName>
    <RootNamespace>SPT_Mod_Korean_Server</RootNamespace>
    <Version>1.0.4</Version>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == '' and '$(ADDON_REFERENCE_ROOT)' != ''">$(ADDON_REFERENCE_ROOT)</ReferenceRoot>
    <ReferenceRoot Condition="'$(ReferenceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\references</ReferenceRoot>
    <ServerRefRoot>$(ReferenceRoot)\server</ServerRefRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/MinimalLog.cs" Link="MinimalLog.cs" />
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(ServerRefRoot)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(ServerRefRoot)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(ServerRefRoot)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(ServerRefRoot)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(ServerRefRoot)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
