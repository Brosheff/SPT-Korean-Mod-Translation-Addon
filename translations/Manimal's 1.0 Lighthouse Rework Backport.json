      },
      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p3/Description",
        "source": "Gonna drop you off near the second facility. Price okay for you, princess?",
        "translation": "두 번째 시설 근처에 내려줄게. 가격은 괜찮지, 공주님?"
      },
      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p3/Name",
        "source": "WTP Building 2 Parking",
        "translation": "WTP 2번 건물 주차장"
      },
      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p4/Description",
        "source": "Crossroads? Sure, not a problem. So, we got a deal?",
        "translation": "교차로? 좋아, 문제없어. 그럼 거래 성립이지?"
      },
      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p4/Name",
        "source": "Village Crossroads",
        "translation": "마을 교차로"
      },
      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p5/Description",
        "source": "Construction it is. Careful not to get sniped. You got the cash on you?",
        "translation": "건설 현장으로 가자고. 저격당하지 않게 조심하고. 현금은 갖고 있지?"
      },
      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p5/Name",
