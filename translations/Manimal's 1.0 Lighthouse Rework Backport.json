      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p1/Description",
        "source": "Next stop — northern roadblock. You got the cash?",
        "translation": "다음은 북쪽 검문소야. 돈은 가져왔지?"
      },
      {
        "key": "Trading/Dialog/PlayerTaxi/Lighthouse/p1/Name",
