      },
      {
        "id": "save_failed_3",
        "source": "Error 3. Failed to save screenshot",
        "translation": "오류 3. 스크린샷 저장 실패",
        "match_mode": "exact"
      },
      {
        "id": "save_failed_4",
        "source": "Error 4. Failed to save screenshot",
        "translation": "오류 4. 스크린샷 저장 실패",
